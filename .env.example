# ==============================================================
# Energy Monitor - Variables de entorno
# Copia este archivo como .env y ajusta los valores:
#     cp .env.example .env
# ==============================================================

# --- Base de datos PostgreSQL ---
POSTGRES_DB=energy_monitor
POSTGRES_USER=energy
POSTGRES_PASSWORD=cambia_esta_clave_local

# --- Puerto de acceso a la aplicación ---
# La web se sirve en http://localhost:APP_PORT
APP_PORT=8080

# --- Zona horaria para mostrar fechas/horas en la interfaz ---
TZ=America/Bogota

# --- Solo para ejecución LOCAL sin Docker (backend directo) ---
# En Docker Compose esta variable se construye automáticamente.
# DATABASE_URL=postgresql+psycopg2://energy:cambia_esta_clave_local@localhost:5432/energy_monitor

# --- Opcional: CORS (por defecto "*" para red local) ---
# CORS_ORIGINS=http://192.168.1.50:8080,http://localhost:8080
